# Copy this file to .env.local and fill in the values.

# Database
# For local dev with docker compose: postgresql://postgres:postgres@localhost:5432/enterprise?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise?schema=public"

# NextAuth
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Claude API (required for AI generation)
ANTHROPIC_API_KEY=""

# Public app URL (exposed to the browser, should match NEXTAUTH_URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Azure Graph API (optional, enables registration, invite and password reset emails)
# The app registration needs Mail.Send permission with admin consent.
# Leave blank and the app still runs: new registrations are auto-verified and
# invitations show a copyable link in the UI instead of being emailed.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SENDER_EMAIL=""

# Firecrawl (optional, enables the brand lookup in organization settings)
# Without it /api/brand returns a "not configured" error and brand fields are
# filled in by hand.
FIRECRAWL_API_KEY=""
